# Soukchay API Configuration
# Copy this file to .env and fill in your database credentials

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=soukchay_sysdata

# CORS origins (comma-separated, no trailing slash)
# Use * for development, specify exact domains for production
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# API key for authentication (optional - remove if not using)
API_KEY=soukchay-api-key-2024

# Server configuration
HOST=0.0.0.0
PORT=5000